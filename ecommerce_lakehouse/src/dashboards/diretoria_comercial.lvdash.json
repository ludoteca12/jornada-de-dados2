{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas detalhadas",
      "queryLines": [
        "SELECT id_venda, data, data_venda, dia_semana, dia_semana_num, hora, canal_venda, ",
        "  CASE WHEN canal_venda = 'ecommerce' THEN 'E-commerce' ",
        "       WHEN canal_venda = 'loja_fisica' THEN 'Loja física' ",
        "       ELSE canal_venda END AS canal_venda_label, ",
        "  id_produto, nome_produto, categoria, marca, quantidade, receita ",
        "FROM vendas_detalhadas"
      ],
      "columns": [
        {
          "displayName": "Receita Total",
          "description": "Receita total em R$ (soma de quantidade x preco_unitario de todas as vendas)",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Vendas",
          "description": "Quantidade de vendas (linhas)",
          "expression": "COUNT(`id_venda`)"
        },
        {
          "displayName": "Ticket Medio",
          "description": "Receita total dividida pelo número de vendas (nunca média de médias)",
          "expression": "SUM(`receita`) / COUNT(`id_venda`)"
        },
        {
          "displayName": "Itens Vendidos",
          "description": "Soma da quantidade de itens vendidos",
          "expression": "SUM(`quantidade`)"
        }
      ]
    },
    {
      "name": "ds_receita_dia_semana",
      "displayName": "Receita média por dia da semana",
      "queryLines": [
        "WITH por_dia AS ( ",
        "  SELECT data, dia_semana, dia_semana_num, SUM(receita) AS receita_do_dia ",
        "  FROM vendas_detalhadas ",
        "  WHERE data BETWEEN :periodo_filtro.min AND :periodo_filtro.max ",
        "    AND (size(:canal_filtro) = 0 OR array_contains(:canal_filtro, ",
        "      CASE WHEN canal_venda = 'ecommerce' THEN 'E-commerce' ",
        "           WHEN canal_venda = 'loja_fisica' THEN 'Loja física' ",
        "           ELSE canal_venda END)) ",
        "  GROUP BY data, dia_semana, dia_semana_num ",
        ") ",
        "SELECT dia_semana, dia_semana_num, AVG(receita_do_dia) AS receita_media ",
        "FROM por_dia ",
        "GROUP BY dia_semana, dia_semana_num ",
        "ORDER BY dia_semana_num"
      ],
      "parameters": [
        {
          "keyword": "periodo_filtro",
          "displayName": "Período",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": { "dataType": "DATE", "min": { "value": "2025-12-13" }, "max": { "value": "2026-01-11" } }
          }
        },
        {
          "keyword": "canal_filtro",
          "displayName": "Canal",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": { "values": { "dataType": "STRING", "values": [] } }
        }
      ]
    },
    {
      "name": "ds_top_produtos",
      "displayName": "Top produtos por receita",
      "queryLines": [
        "SELECT id_produto, nome_produto, categoria, SUM(receita) AS receita ",
        "FROM vendas_detalhadas ",
        "WHERE data BETWEEN :periodo_filtro.min AND :periodo_filtro.max ",
        "  AND (size(:canal_filtro) = 0 OR array_contains(:canal_filtro, ",
        "    CASE WHEN canal_venda = 'ecommerce' THEN 'E-commerce' ",
        "         WHEN canal_venda = 'loja_fisica' THEN 'Loja física' ",
        "         ELSE canal_venda END)) ",
        "GROUP BY id_produto, nome_produto, categoria ",
        "ORDER BY receita DESC ",
        "LIMIT 10"
      ],
      "parameters": [
        {
          "keyword": "periodo_filtro",
          "displayName": "Período",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": { "dataType": "DATE", "min": { "value": "2025-12-13" }, "max": { "value": "2026-01-11" } }
          }
        },
        {
          "keyword": "canal_filtro",
          "displayName": "Canal",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": { "values": { "dataType": "STRING", "values": [] } }
        }
      ]
    }
  ],
